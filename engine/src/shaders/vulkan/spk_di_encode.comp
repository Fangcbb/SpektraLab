#version 450
#extension GL_GOOGLE_include_directive : require
#include "spk_dispatch.glsl"
layout(local_size_x=256) in;
float log10(float x) { return log(x) * 0.4342944819032518; }
vec3 log10(vec3 x) { return log(x) * 0.4342944819032518; }
layout(std430,binding=0) readonly buffer B0 { float y[]; };
layout(std430,binding=1) readonly buffer B1 { float p[]; };
layout(std430,binding=2) readonly buffer B2 { uint n[]; };
layout(std430,binding=3) writeonly buffer B3 { float dst[]; };

void main() {

    uint i = spk_global_index();
    if (i >= n[0]) return;
    vec3 pos = vec3(pow(10.0f, y[3u * i] + p[9]),
                        pow(10.0f, y[3u * i + 1u] + p[10]),
                        pow(10.0f, y[3u * i + 2u] + p[11]));
    // The base is black: the same floor on every channel, scaled with the
    // live gain so brightness and the filters never lift it.
    pos -= vec3(p[40]) * vec3(pow(10.0f, p[9]), pow(10.0f, p[10]), pow(10.0f, p[11]));
    vec3 lin = vec3(pos.x * p[0] + pos.y * p[3] + pos.z * p[6],
                        pos.x * p[1] + pos.y * p[4] + pos.z * p[7],
                        pos.x * p[2] + pos.y * p[5] + pos.z * p[8]);
    if (p[30] != 0.0f) {
        // Oklab (Ottosson 2020); the window sits on the output hue and fades
        // out below a chroma floor, so greys and every other hue are exact.
        vec3 lms = vec3(p[12] * lin.x + p[13] * lin.y + p[14] * lin.z,
                            p[15] * lin.x + p[16] * lin.y + p[17] * lin.z,
                            p[18] * lin.x + p[19] * lin.y + p[20] * lin.z);
        lms = pow(max(lms, 0.0f), vec3(1.0f / 3.0f));
        float L = 0.2104542553f * lms.x + 0.7936177850f * lms.y - 0.0040720468f * lms.z;
        float a = 1.9779984951f * lms.x - 2.4285922050f * lms.y + 0.4505937099f * lms.z;
        float b = 0.0259040371f * lms.x + 0.7827717662f * lms.y - 0.8086757660f * lms.z;
        float C = sqrt(a * a + b * b);
        float h = atan(b, a) * 57.29577951308232f;
        float d = mod(h - p[33] + 540.0f, 360.0f) - 180.0f;
        float w = abs(d) < p[34] ? 0.5f * (1.0f + cos(3.14159265358979f * d / p[34])) : 0.0f;
        float g = clamp((C - p[35]) / (p[36] - p[35]), 0.0f, 1.0f);
        w *= g * g * (3.0f - 2.0f * g);
        if (w > 0.0f) {
            float h2 = (h + w * p[31]) * 0.017453292519943295f;
            float C2 = C * (1.0f + w * (p[32] - 1.0f));
            a = C2 * cos(h2);
            b = C2 * sin(h2);
            vec3 l_ = vec3(L + 0.3963377774f * a + 0.2158037573f * b,
                               L - 0.1055613458f * a - 0.0638541728f * b,
                               L - 0.0894841775f * a - 1.2914855480f * b);
            lms = l_ * l_ * l_;
            lin = vec3(p[21] * lms.x + p[22] * lms.y + p[23] * lms.z,
                         p[24] * lms.x + p[25] * lms.y + p[26] * lms.z,
                         p[27] * lms.x + p[28] * lms.y + p[29] * lms.z);
        }
    }
    // Kodak's Cineon encode with the black offset (`log_encoding_Cineon`).
    vec3 code = (p[37] + p[38] * log10(max(lin, 0.0f) * (1.0f - p[41]) + p[41])) / p[39];
    code = clamp(code, 0.0f, 1.0f);
    dst[3u * i] = code.x; dst[3u * i + 1u] = code.y; dst[3u * i + 2u] = code.z;

}
