#version 450
#extension GL_GOOGLE_include_directive : require
#include "spk_dispatch.glsl"
layout(local_size_x=256) in;
float log10(float x) { return log(x) * 0.4342944819032518; }
vec3 log10(vec3 x) { return log(x) * 0.4342944819032518; }
layout(std430,binding=0) readonly buffer B0 { float mask[]; };
layout(std430,binding=1) readonly buffer B1 { float M[]; };
layout(std430,binding=2) readonly buffer B2 { uint n[]; };
layout(std430,binding=3) writeonly buffer B3 { float canvas[]; };

void main() {

    const uint i = spk_global_index();
    if (i >= n[0]) return;
    const uint mw = uint(M[2]);
    const int x = int(M[0]) + int(i % mw), y = int(M[1]) + int(i / mw);
    if (x < 0 || y < 0 || x >= int(M[4]) || y >= int(M[5])) return;
    const float c = mask[i];
    if (c <= 0.0f) return;
    const uint o = 3u * (uint(y) * uint(M[4]) + uint(x));
    canvas[o] += c * M[6];
    canvas[o + 1u] += c * M[7];
    canvas[o + 2u] += c * M[8];

}
